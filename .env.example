# Database Configuration
DATABASE_URL=mysql+pymysql://ptas_user:ptas_password@localhost:3306/ptas_db
URL=jdbc:mariadb://localhost:3306/
Server Host=localhost
Port=3306
Database=ptas_db
Username=ptas_user
Password=ptas_password

# API Configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# JWT Configuration (if needed)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=2

# Nmap Configuration
NMAP_PATH=/usr/bin/nmap
NMAP_TIMEOUT=300

# CORS Configuration (if needed)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Application Configuration
APP_NAME=PTAS
APP_VERSION=1.0.0

# Optional local terminal assistant (Ollama is never used unless selected)
PTAS_LLM_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
